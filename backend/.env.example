# VexaAccount backend runtime configuration
NODE_ENV=production
PORT=4000

# TiDB Cloud / MySQL-compatible database
DB_HOST=your-tidb-host
DB_PORT=4000
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=vexaaccount
DB_SSL=true

# REQUIRED in production: generate a long random secret and store it only in the backend deployment secret store.
JWT_SECRET=replace-with-a-long-random-production-secret
VEXA_ACCOUNT_ISSUER=https://api.example.com

# CORS: comma-separated exact frontend origins; do not use * with credentials.
CORS_ORIGINS=https://account.example.com,https://admin.account.example.com

# Cookie/security settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
