# VexaAccount backend runtime configuration
NODE_ENV=production
PORT=4000

# TiDB Cloud / MySQL-compatible database
DB_HOST=your-tidb-host
DB_PORT=4000
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=vexaaccount
DB_SSL=true

# Required authentication secret
JWT_SECRET=replace-with-a-long-random-production-secret
VEXA_ACCOUNT_ISSUER=https://api-vexaaccount.onrender.com

# Environment-backed Super Admin login
VEXA_SUPER_ADMIN_EMAIL=admin@example.com
VEXA_SUPER_ADMIN_PASSWORD=replace-with-a-strong-secret
VEXA_SUPER_ADMIN_NAME=VexaAccount Super Admin

# CORS: comma-separated exact frontend/ecosystem origins; do not use * with credentials.
CORS_ORIGINS=https://account.example.com,https://admin.account.example.com,https://vexatrade.example.com,https://vexastore.example.com

# Cookie/security settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Optional explicit ecosystem origins (also accepted by the backend)
FRONTEND_USER_URL=https://account.example.com
FRONTEND_ADMIN_URL=https://admin.account.example.com
VEXA_ALLOWED_ORIGINS=https://vexatrade.example.com,https://vexastore.example.com

# Cloudinary media storage (server-side only; NEVER expose API secret to the browser)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
