# VexaAccount backend runtime configuration
NODE_ENV=production
PORT=4000

# TiDB Cloud / MySQL-compatible database
DB_HOST=your-tidb-host
DB_PORT=4000
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=vexaaccount
DB_SSL=true

# Required authentication secret
JWT_SECRET=replace-with-a-long-random-production-secret
VEXA_ACCOUNT_ISSUER=https://api-vexaaccount.onrender.com

# Environment-backed Super Admin login
VEXA_SUPER_ADMIN_EMAIL=admin@example.com
VEXA_SUPER_ADMIN_PASSWORD=replace-with-a-strong-secret
VEXA_SUPER_ADMIN_NAME=VexaAccount Super Admin

# MTP2026 SSO is Owner-Controlled. The Owner Control Center can create/rotate the client
# and push the client credentials/configuration directly to the selected MTP2026 Render service.
# These legacy bootstrap variables are optional compatibility overrides only.
MTP2026_SSO_CLIENT_ID=vexa_mtp2026-app-launcher_b1f581a66224d89c
MTP2026_SSO_CLIENT_SECRET=
MTP2026_SSO_REDIRECT_URI=https://mtp2026-app-launcher.onrender.com/auth/callback

# Owner Infrastructure Control (server-side only): connect Render from Owner OS rather than exposing API keys in frontend source.
# The Render API key is encrypted in the VexaAccount database after Owner connects it from the Super Admin panel.
RENDER_API_URL=https://api.render.com

# Required cryptographic signing secret for Owner SSO source plans/manifests.
OWNER_SSO_PLAN_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# CORS: comma-separated exact frontend/ecosystem origins; do not use * with credentials.
CORS_ORIGINS=https://account.example.com,https://admin.account.example.com,https://vexatrade.example.com,https://vexastore.example.com,https://mtp2026-app-launcher.onrender.com

# Cookie/security settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Optional explicit ecosystem origins (also accepted by the backend)
FRONTEND_USER_URL=https://account.example.com
FRONTEND_ADMIN_URL=https://admin.account.example.com
VEXA_ALLOWED_ORIGINS=https://vexatrade.example.com,https://vexastore.onrender.com,https://mtp2026-app-launcher.onrender.com

# Cloudinary media storage (server-side only; NEVER expose API secret to the browser)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
