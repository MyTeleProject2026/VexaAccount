# VexaAccount backend runtime configuration
NODE_ENV=production
PORT=4000

# TiDB Cloud / MySQL-compatible database
DB_HOST=your-tidb-host
DB_PORT=4000
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=vexaaccount
DB_SSL=true

# REQUIRED in production
JWT_SECRET=replace-with-a-long-random-production-secret
VEXA_ACCOUNT_ISSUER=https://api-vexaaccount.onrender.com

# Exact frontend origins (comma-separated)
FRONTEND_USER_URL=https://account.example.com
FRONTEND_ADMIN_URL=https://admin.account.example.com
VEXA_ALLOWED_ORIGINS=https://account.example.com,https://admin.account.example.com

# First-owner bootstrap. Store these ONLY in Render secret environment variables.
# The password is hashed with bcrypt at startup and is never stored in source code.
VEXA_SUPER_ADMIN_EMAIL=admin@vexaccount.com
VEXA_SUPER_ADMIN_PASSWORD=replace-with-your-admin-password

# Cookie/security settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
