# Example environment variables for VexAccount
# Copy to .env and fill values locally (do NOT commit real secrets)

PORT=3000
DB_URL=mongodb://localhost:27017/vexaccount
JWT_SECRET=your_jwt_secret
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_email_password

CORS_ORIGINS=https://account.example.com,https://admin.example.com
TRUST_PROXY=1
