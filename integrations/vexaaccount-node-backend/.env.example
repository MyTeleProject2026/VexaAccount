# VexaAccount integration — BACKEND ONLY
# Exactly two VexaAccount-specific variables are required.
VEXA_ACCOUNT_CLIENT_SECRET=replace-with-the-secret-issued-by-vexaaccount-owner
VEXA_ACCOUNT_SSO_CONFIG={"url":"https://api-vexaaccount.onrender.com","clientId":"replace-with-client-id","redirectUri":"https://your-app.example.com/auth/vexaaccount/callback","scopes":["openid","profile","email"],"timeoutMs":10000}

# Never add clientSecret to VEXA_ACCOUNT_SSO_CONFIG.
# Keep VEXA_ACCOUNT_CLIENT_SECRET server-side only.
